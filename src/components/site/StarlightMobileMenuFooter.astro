---
import { mainNav, navLabels, docPath, toLocale } from '@/data/site-nav';
import { copy } from '@/data/site-copy';

const locale = toLocale(Astro.locals.starlightRoute.locale);
const links = mainNav(locale, 'docs');
const labels = navLabels(locale);
const t = copy[locale];
const aboutHref = docPath(locale, '/more/about/');
---

<!--
  Site links for the documentation mobile menu. Starlight's own theme and
  language pickers stay in place below this list, so this only adds the four
  top-level sections that the sidebar toggle would otherwise hide on narrow
  viewports.
-->
<nav class="mobile-site-nav sl-flex" aria-label={labels.site}>
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={link.active ? 'page' : undefined}
        class:list={['mobile-site-nav-link', { 'is-current': link.active }]}
      >
        {link.label}
      </a>
    ))
  }
  <a href={aboutHref} class="mobile-site-nav-link">{t.about}</a>
</nav>

<style>
  @layer starlight.components {
    .mobile-site-nav {
      flex-wrap: wrap;
      gap: 0.25rem;
      padding-block: 0.5rem;
    }
    .mobile-site-nav-link {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 0.85rem;
      border-radius: 0.5rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-text);
      text-decoration: none;
    }
    .mobile-site-nav-link:hover {
      background-color: var(--sl-color-gray-6);
    }
    .mobile-site-nav-link.is-current {
      color: var(--sl-color-accent-high);
      background-color: var(--sl-color-accent-low);
    }
    .mobile-site-nav-link:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
  }
</style>
