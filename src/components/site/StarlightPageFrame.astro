---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import { marketingPageFor } from '../../data/site-nav';

const isMarketing = marketingPageFor(Astro.url.pathname) !== undefined;
---

{
  isMarketing ? (
    <div class="site-ui min-h-screen bg-background text-foreground">
      <header class="border-b border-border">
        <slot name="header" />
      </header>
      <slot />
    </div>
  ) : (
    <Default>
      <slot name="header" slot="header" />
      <slot name="sidebar" slot="sidebar" />
      <slot />
    </Default>
  )
}
