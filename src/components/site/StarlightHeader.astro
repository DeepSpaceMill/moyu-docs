---
/**
 * Starlight's Header override.
 *
 * The header box is fixed and sized by Starlight through --sl-nav-height, and
 * Starlight also owns its horizontal padding: the end side reserves room for
 * the fixed sidebar toggle on narrow viewports. This component therefore only
 * fills the box; SiteHeader decides how wide its content runs. Documentation
 * keeps the full width so the bar lines up with the three-column document
 * layout, while marketing pages centre their content in a fixed container.
 */
import SiteHeader from './SiteHeader.astro';
import { toLocale } from '@/data/site-nav';

const locale = toLocale(Astro.locals.starlightRoute.locale);
---

<div class="site-header-inner">
  <SiteHeader locale={locale} />
</div>

<style>
  @layer starlight.core {
    .site-header-inner {
      display: flex;
      align-items: center;
      height: 100%;
    }
  }
</style>
